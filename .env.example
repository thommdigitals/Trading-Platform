# ---------------------------------------------------------------------------
# Public (browser-visible) settings. Never put secrets in NEXT_PUBLIC_* values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="FortunoAI Trading"
NEXT_PUBLIC_APP_VERSION=1.0.0

# Where the browser sends Fortuno/Match-Trader API calls.
#  - "/api/proxy"  (default, recommended): same-origin hardened proxy, avoids CORS.
#  - "https://trader-api.match-trader.com": direct calls (only if the API allows your origin via CORS).
NEXT_PUBLIC_FORTUNO_API_BASE=/api/proxy

# ---------------------------------------------------------------------------
# Server-only settings (used by the proxy route and security headers).
# ---------------------------------------------------------------------------
# Upstream Match-Trader API (must be https).
FORTUNO_UPSTREAM_URL=https://trader-api.match-trader.com

# Max proxied requests per client IP per minute.
PROXY_RATE_LIMIT_PER_MINUTE=600

# Upstream timeout for proxied requests (ms).
PROXY_TIMEOUT_MS=15000

# Max accepted request body size for the proxy (bytes).
PROXY_MAX_BODY_BYTES=16384

# Extra origins allowed in the CSP connect-src directive (space separated).
# Add self-hosted / custom AI provider origins here, e.g. "https://api.deepseek.com".
CSP_EXTRA_CONNECT_SRC=

